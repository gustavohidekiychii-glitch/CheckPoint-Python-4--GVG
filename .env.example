# Padrão (não precisa mudar nada): banco SQLite local, cria o arquivo escola.db sozinho.
DATABASE_URL=sqlite:///./escola.db

# Para usar Oracle (ex: Oracle SQL Developer / Oracle XE) descomente e ajuste a linha abaixo,
# e instale a dependência "oracledb" (está comentada no requirements.txt):
# DATABASE_URL=oracle+oracledb://usuario:senha@localhost:1521/?service_name=xe
